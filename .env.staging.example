# Local staging environment. This is production-like but not production.

POSTGRES_USER=legal_user
POSTGRES_DB=legal_db
POSTGRES_PASSWORD=staging-postgres-password-please-change
POSTGRES_MAX_CONNECTIONS=500
POSTGRES_RESERVED_CONNECTIONS=80
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://legal_user:staging-postgres-password-please-change@pgbouncer:6432/legal_db
MIGRATION_DATABASE_URL=postgresql://legal_user:staging-postgres-password-please-change@postgres:5432/legal_db
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
PGBOUNCER_ENABLED=1
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=80
PGBOUNCER_RESERVE_POOL_SIZE=40

REDIS_PASSWORD=staging-redis-password-please-change
REDIS_URL=redis://:staging-redis-password-please-change@redis:6379/0

DASHSCOPE_API_KEY=staging-dashscope-key-not-for-production
DASHSCOPE_API_KEY_ALIAS=
OCR_SPACE_API_KEY=

APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=staging-session-secret-please-change-123456
JWT_SECRET=staging-jwt-secret-please-change-123456
AUTO_CREATE_TABLES=0
BACKEND_IMAGE=legal-ai-assistant:staging
WORKER_IMAGE=legal-ai-assistant-worker:staging
WEB_CONCURRENCY=4
EXPECTED_APP_REPLICAS=4
AUTH_CONTEXT_CACHE_SECONDS=10

CORS_ORIGINS=https://legal-staging.local
TRUSTED_HOSTS=legal-staging.local,localhost,127.0.0.1

RATE_LIMIT_RPM=60000
RATE_LIMIT_RPH=1000000
USE_REDIS_RATE_LIMIT=1
REDIS_RATE_LIMIT_ALLOW_FALLBACK=0

SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=http://sms-mock:8088/send
SMS_HTTP_TOKEN=staging-sms-token
SMS_MOCK_TOKEN=staging-sms-token
SMS_CODE_TTL_MINUTES=5
SMS_CODE_RESEND_SECONDS=0
SMS_CODE_MAX_ATTEMPTS=5
SMS_DEBUG_RETURN_CODE=0

MAX_FILE_SIZE_MB=50
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
FILE_STORAGE_PATH=/app/data/files
API_KEY_CONFIG_FILE=/app/data/config/api-keys.env

NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
