# ============================================================
# 法律大模型 - 生产环境配置模板
# 复制为 .env.fl-prod 并填入选值
# ============================================================
APP_ENV=production
APP_NAME=法律大模型
JWT_SECRET=<生成一个随机密钥>
AUTH_CONTEXT_CACHE_SECONDS=60
SECRET_KEY=<生成一个随机密钥>
CORS_ORIGINS=https://fl.jilinpc.com
USE_REDIS_RATE_LIMIT=1

DATABASE_URL=postgresql://postgres:<密码>@legal-ai-pg:5432/legal_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<数据库密码>
POSTGRES_DB=legal_ai
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_RESERVED_CONNECTIONS=50

REDIS_URL=redis://:<密码>@legal-ai-redis:6379/0
REDIS_PASSWORD=<Redis密码>

SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=http://sms-gateway:8090/send
SMS_HTTP_TOKEN=<短信网关Token>
SMS_DEBUG_RETURN_CODE=0

ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=<阿里云短信签名>
ALIYUN_SMS_TEMPLATE_CODE=<阿里云短信模板CODE>
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
ALIYUN_SMS_ACCESS_KEY_ID=<阿里云AccessKey ID>
ALIYUN_SMS_ACCESS_KEY_SECRET=<阿里云AccessKey Secret>

LLM_PROVIDER=cloud
DASHSCOPE_API_KEY=<通义千问API Key>

WEB_CONCURRENCY=2
EXPECTED_APP_REPLICAS=1
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=30
PGBOUNCER_ENABLED=0
LOG_LEVEL=INFO
DOMAIN=fl.jilinpc.com
