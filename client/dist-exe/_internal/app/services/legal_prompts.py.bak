def get_system_prompt_with_facts(case_type: str, user_position: str, case_direction: str = "mediate") -> str:
    """
    根据案件类型、用户立场和案件方向生成针对性提示词

    Args:
        case_type: 案件类型（合同纠纷/侵权纠纷/劳动纠纷等）
        user_position: 用户立场（有利/不利）
        case_direction: 案件处理方向（negotiate/mediate/litigate/contain/retreat）

    Returns:
        定制化的系统提示词
    """
    prompt = LEGAL_SYSTEM_PROMPT

    # 根据案件类型添加特定规则
    case_specific_rules = {
        "合同纠纷": """
### 合同纠纷特别规则

1. **合同效力审查**
   - 合同是否成立于民法典第143条规定的时间？
   - 是否存在民法典第146条规定的通谋虚伪表示？
   - 是否存在民法典第153条规定的无效情形？

2. **履约情况审查**
   - 合同是否已生效？
   - 双方履约情况如何？
   - 是否存在先履行抗辩权或不安抗辩权的情形？

3. **违约责任审查**
   - 违约事实是什么？
   - 违约责任条款是否有效？
   - 违约金是否过高（可请求法院调减）？
""",
        "侵权纠纷": """
### 侵权纠纷特别规则

1. **侵权构成要件**
   - 违法行为
   - 损害事实
   - 因果关系
   - 主观过错

2. **举证责任分配**
   - 一般侵权：谁主张谁举证
   - 特殊侵权：举证责任倒置情形

3. **责任承担方式**
   - 停止侵害
   - 排除妨碍
   - 消除危险
   - 返还财产
   - 恢复原状
   - 赔偿损失
   - 消除影响、恢复名誉
   - 赔礼道歉
""",
        "劳动纠纷": """
### 劳动纠纷特别规则

1. **仲裁前置**
   - 劳动争议必须先申请仲裁
   - 仲裁时效：1年

2. **举证责任**
   - 用人单位掌握的证据，由用人单位举证
   - 工资支付记录、考勤记录等

3. **经济补偿/赔偿**
   - 违法解除：2N
   - 协商解除：N或N+1
   - 劳动合同法第46条、第47条规定
"""
    }

    if case_type in case_specific_rules:
        prompt += case_specific_rules[case_type]

    # 根据用户立场调整策略
    if user_position == "有利":
        prompt += """

### 进攻策略强化

当前立场：您处于有利地位

**策略重点：**
1. 最大化权利主张
2. 全面收集有利证据
3. 优化诉讼请求设计
4. 把握最佳诉讼时机
"""
    else:
        prompt += """

### 防御策略强化

当前立场：您处于不利地位

**策略重点：**
1. 审查对方主张的法律依据
2. 寻找减轻/免除责任的事由
3. 评估和解可能性
4. 控制诉讼成本
"""

    # 添加案件处理方向
    prompt += "\n\n" + get_direction_prompt(case_direction)

    return prompt


