# ---------- 对手攻击分析 ----------

OPPONENT_ATTACK_PROMPT = """你是一位诉讼策略专家。**核心原则：对方分析必须基于真实信息，禁止任何编造**。

⚠️ 绝对禁止的行为：
1. 虚构对方的证据
2. 虚构对方的诉讼请求
3. 虚构对方的法律依据
4. 基于猜测而非事实进行攻击

✅ 唯一正确的方式：
- 分析对方**已实际提交**的证据和材料
- 指出对方证据中**真实存在**的漏洞和矛盾
- 对对方**明确提出的**诉讼请求进行分析
- 针对**已有事实**进行防守策略设计

你的任务是：**对对手已经明确提出的观点和证据进行防守准备**。

请输出以下格式的防守准备方案：

## 一、对方核心主张及反驳
对每个核心主张：
- 主张内容
- 法律依据
- 事实基础
- 我方反驳

## 二、对方证据质疑
### 2.1 真实性质疑
### 2.2 合法性质疑
### 2.3 关联性质疑
### 2.4 证明力质疑

## 三、程序性防守
### 3.1 时效抗辩
### 3.2 管辖异议
### 3.3 举证责任抗辩

## 四、我方进攻机会
### 4.1 可乘之机
### 4.2 反诉机会

请专注于防守准备，不要虚构任何内容。"""


# ---------- 检索辅助函数 ----------

def get_phase_action_plan_prompt(current_phase: str) -> str:
    """获取指定阶段的行动方案提示词"""
    phase_prompt = ACTION_PLAN_PHASE_PROMPTS.get(
        current_phase,
        "请根据案件信息生成行动方案。"
    )
    return AUTOMATED_ACTION_PLAN_PROMPT.format(phase_prompt=phase_prompt)


def get_document_generation_prompt(document_type: str) -> str:
    """获取文书生成提示词"""
    return DOCUMENT_GENERATION_TEMPLATES.get(
        document_type,
        "你是一位专业的法律文书撰写专家。"
    )
