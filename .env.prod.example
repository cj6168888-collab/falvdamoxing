# Copy this file to .env.prod and replace every placeholder before deploying.

# Database
POSTGRES_USER=legal_user
POSTGRES_DB=legal_db
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_MAX_CONNECTIONS=500
POSTGRES_RESERVED_CONNECTIONS=80
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://legal_user:change_me_postgres_password@pgbouncer:6432/legal_db
MIGRATION_DATABASE_URL=postgresql://legal_user:change_me_postgres_password@postgres:5432/legal_db
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
PGBOUNCER_ENABLED=1
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=80
PGBOUNCER_RESERVE_POOL_SIZE=40

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# LLM providers
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_API_KEY_ALIAS=
# OPENAI_API_KEY=your_openai_api_key_here

# External legal/company data providers
LAW_API_KEY=your_law_api_key_here
LAW_API_BASE_URL=https://api.law.yibie.net
COMPANY_INFO_API_BASE_URL=https://provider.example.com/api
COMPANY_INFO_API_KEY=your_company_info_api_key_here
HOLIDAY_API_KEY=
HOLIDAY_API_BASE_URL=https://apis.juhe.cn

# Optional OCR provider
OCR_SPACE_API_KEY=your_ocr_space_key_here

# Application
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=change_me_session_secret
JWT_SECRET=change_me_jwt_secret
AUTO_CREATE_TABLES=0
BACKEND_IMAGE=legal-ai-assistant:latest
WORKER_IMAGE=legal-ai-assistant-worker:latest
WEB_CONCURRENCY=4
EXPECTED_APP_REPLICAS=4
AUTH_CONTEXT_CACHE_SECONDS=10

# Restrict production CORS origins to your real domains.
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
TRUSTED_HOSTS=your-domain.com,www.your-domain.com

# Rate limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000
USE_REDIS_RATE_LIMIT=1
REDIS_RATE_LIMIT_ALLOW_FALLBACK=0

# SMS verification
# Use provider=http in production and point it at your SMS gateway adapter.
SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=https://sms-provider.example.com/send
SMS_HTTP_TOKEN=change_me_sms_gateway_token
SMS_CODE_TTL_MINUTES=5
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
SMS_DEBUG_RETURN_CODE=0

# Uploads and storage
MAX_FILE_SIZE_MB=50
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
FILE_STORAGE_PATH=/app/data/files
API_KEY_CONFIG_FILE=/app/data/config/api-keys.env
